# Copy to .env.local and fill in. Never commit .env.local.
#
# QUOTING RULE: a value that contains #, $, spaces or quotes must be in SINGLE quotes, for example
#   SMTP_PASS='p#ss$word'
# Unquoted, # starts a comment (the value silently becomes empty or truncated) and $ is expanded as a variable.
# In Vercel's dashboard paste the value as it is, without quotes.
# Each key must appear once: the loader keeps the LAST one, silently. `npm run check-env` warns about duplicates
# and the server refuses to start when a required setting is missing (or SMTP_PASS is empty with EMAIL_PROVIDER=smtp).

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key. Safe in the browser: RLS limits it to published articles.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI ---
# Which LLM provider every agent uses: gemini (default) or anthropic.
# Model names per provider live in lib/config.ts.
LLM_PROVIDER=gemini
# Only the key for the selected provider is required.
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=sk-ant-...
# Write and fact-check may run on another provider: gemini, anthropic, or an OpenAI-compatible free tier (groq).
# Empty = LLM_PROVIDER. Classify always stays on LLM_PROVIDER.
WRITE_LLM_PROVIDER=
FACTCHECK_LLM_PROVIDER=
# Groq (https://console.groq.com/keys). Free tier: 30 requests/min, so calls are spaced 2 s apart; at most BATCH_LIMIT items per run.
GROQ_API_KEY=
# A model id exactly as Groq's model list spells it (https://console.groq.com/docs/models). openai/gpt-oss-120b is a production
# model with structured outputs (checked 2026-10-29). Required when a stage uses groq: there is no default.
GROQ_MODEL=openai/gpt-oss-120b

# --- Images ---
# Image provider for the image stage. Only unsplash is implemented.
IMAGE_PROVIDER=unsplash
# Unsplash Access Key (https://unsplash.com/oauth/applications). Server only.
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# --- Security ---
# Long random string (at least 16 chars), e.g. `openssl rand -hex 32`. Vercel Cron sends it as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string
# Comma-separated list of emails allowed into /admin (one line only)
ADMIN_EMAILS=editor@example.com,admin@example.com
# Admin sessions: signed out after this many minutes without an admin request (default 30)...
ADMIN_IDLE_MINUTES=30
# ...and this many hours after signing in, whatever they are doing (default 8)
ADMIN_SESSION_HOURS=8
# Optional secret that signs the admin activity cookie (16+ characters). Defaults to CRON_SECRET.
ADMIN_SESSION_SECRET=

# --- Volume (all optional; defaults live in PIPELINE_DEFAULTS in lib/config.ts, sized for a weekly run) ---
# Max items one stage processes per run, across its chunks. Also the cap for one cron call.
BATCH_LIMIT=25
# Max new items taken from one feed per ingest run, newest first
MAX_ITEMS_PER_FEED=15
# A stage works through its queue this many items at a time, pausing STAGE_DELAY_MS between chunks
STAGE_CHUNK_SIZE=5
STAGE_DELAY_MS=1500
# A stage stops starting new items after this long, so it ends before the route's maxDuration (60s)
STAGE_TIME_BUDGET_MS=50000
# One LLM call is given up on after this long; the item stays queued (default 45000).
LLM_TIMEOUT_MS=45000
# Most the LLM calls may cost per day in USD, Asia/Kolkata day (default 2). Stages stop and items stay queued when it is reached;
# an admin can raise today's limit from /admin.
DAILY_BUDGET_USD=2

# --- Pipeline tuning ---
# Classify keeps items with relevance >= this (0-10)
RELEVANCE_THRESHOLD=7
# Classify skips items whose source was published more than this many days ago (reason: too_old)
MAX_ITEM_AGE_DAYS=3
# true = skip items matching no department keyword before calling the LLM
KEYWORD_PRECHECK=true
# Items whose source text is shorter than this (in words) are skipped at the write stage
MIN_SOURCE_WORDS=120

# --- Fetching ---
# Identifiable User-Agent for RSS and article-page requests (include a contact address)
FETCH_USER_AGENT=AINewsroomBot/1.0 (+mailto:newsroom@example.com)
FETCH_TIMEOUT_MS=10000

# --- Weekly email digest ---
# Public URL of the dashboard (links in the email). Required to build the email.
SITE_URL=https://newsroom.example.com
# Stories per digest, lead included. 1 = a single-story digest.
DIGEST_MAX_STORIES=6
# Optional: one distribution list that gets the digest as a single message (in addition to the recipients on /admin/digest)
DIGEST_TO=
# Optional: shown in the email footer
DIGEST_CONTACT=newsroom@example.com

# smtp | graph | none (default none: nothing is sent; preview and Download .eml still work)
EMAIL_PROVIDER=none
# Sender. Required for smtp and graph; for Microsoft 365 it must be the mailbox you log in with (or one it can send as).
MAIL_FROM=Company Newsroom <newsroom@example.com>

# EMAIL_PROVIDER=smtp (Microsoft 365: smtp.office365.com, port 587 with STARTTLS).
# The mailbox needs SMTP AUTH enabled by IT, or you get "535 5.7.139"; use Download .eml until then.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=newsroom@example.com
SMTP_PASS='change-me'
# EMAIL_PROVIDER=graph (Entra app registration with the Mail.Send application permission)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# --- Employee submissions (/submit, no login) ---
# Comma-separated company email domains allowed to submit (exact match, e.g. adorpower.com). A typo is an error on
# startup, not an empty list. Leave empty to accept any email: stories are then flagged "unverified" for the admin.
ALLOWED_EMAIL_DOMAINS=
# Optional secret mixed into the stored IP hash (16+ characters). Defaults to CRON_SECRET.
SUBMISSION_HASH_SALT=
# Shown on /submit for requests to see or delete one's data. Required in production (npm run check-env -- --production).
PRIVACY_CONTACT=
# Privacy retention of /submit details: the hash of the IP is deleted after this many days (default 7)...
SUBMITTER_IP_RETENTION_DAYS=7
# ...and the email is anonymized this many days after the story was published or rejected (default 90).
SUBMITTER_EMAIL_RETENTION_DAYS=90
# Content-Security-Policy: report-only (default, nothing is blocked) or enforce. Read at BUILD time: change it, then deploy again.
CSP_MODE=report-only
# Cloudflare Turnstile on /submit: set BOTH to turn it on, neither to leave it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# --- Self-hosting on a company LAN over plain http (npm run start:lan, docs/SELF_HOST.md). Ignored by `next start` and Vercel. ---
# Address and port the server listens on (defaults 0.0.0.0 and 3000).
HOST=
PORT=
# Who may reach /admin: localhost (default: only the server PC) or lan-insecure-http (the whole LAN; admin passwords and
# session cookies then cross the network UNENCRYPTED). Any other value means localhost.
SELF_HOST_ADMIN=
# --- Local dev only: base URL used by `npm run stage` ---
APP_URL=http://localhost:3000

